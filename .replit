modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "autopilot-unit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "media-unit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "service-lifecycle"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "publisher-process"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "render-guardrails"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "editor-regeneration"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "storage-retention"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "unified-posting"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "youtube-feeds"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pipeline-upgrade"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "autopilot-unit"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx --test --test-concurrency=1 ../artifacts/api-server/src/tests/slots.test.ts ../artifacts/api-server/src/tests/ingestion.test.ts ../artifacts/api-server/src/pipeline/ingestion.test.ts ../artifacts/api-server/src/tests/youtube-network.test.ts ../artifacts/api-server/src/tests/adapters.test.ts"

[[workflows.workflow]]
name = "media-unit"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = ".pythonlibs/bin/python3 -m unittest discover -s artifacts/api-server/src/pipeline -p \"test_*.py\" -v"

[[workflows.workflow]]
name = "service-lifecycle"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -w 240 /tmp/veloce-queue-regressions.lock pnpm --filter @workspace/scripts exec tsx --test --test-concurrency=1 ../artifacts/api-server/src/tests/lifecycle.test.ts ../artifacts/api-server/src/tests/worker-readiness.test.ts ../artifacts/api-server/src/tests/worker-recovery.test.ts"

[[workflows.workflow]]
name = "publisher-process"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/tests/publisher-process.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "render-guardrails"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -w 240 /tmp/veloce-queue-regressions.lock pnpm --filter @workspace/scripts exec tsx --test --test-concurrency=1 ../artifacts/api-server/src/tests/guardrails.test.ts ../artifacts/api-server/src/tests/queue.test.ts"

[[workflows.workflow]]
name = "editor-regeneration"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx --test --test-concurrency=1 ../artifacts/api-server/src/tests/regeneration.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "storage-retention"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/tests/storage-cleanup.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "unified-posting"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx --test --test-concurrency=1 ../artifacts/api-server/src/tests/unified-posting.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "youtube-feeds"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -w 240 /tmp/veloce-queue-regressions.lock pnpm --filter @workspace/scripts exec tsx --test --test-concurrency=1 ../artifacts/api-server/src/tests/youtube-feeds.test.ts"

[[workflows.workflow]]
name = "pipeline-upgrade"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -w 240 /tmp/veloce-queue-regressions.lock pnpm --filter @workspace/scripts exec tsx --test --test-concurrency=1 ../artifacts/api-server/src/tests/ai-routing.test.ts ../artifacts/api-server/src/tests/ai-usage.test.ts ../artifacts/api-server/src/tests/guardrails.test.ts ../artifacts/api-server/src/tests/queue.test.ts ../artifacts/api-server/src/tests/regeneration.test.ts ../artifacts/api-server/src/tests/youtube-feeds.test.ts"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"
packages = ["ffmpeg", "python313", "yt-dlp", "gcc", "zlib"]
